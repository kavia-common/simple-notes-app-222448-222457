# Backend service (FastAPI) environment variables
# Prefer a full DATABASE_URL; otherwise set individual POSTGRES_* vars.
# Example full URL (psycopg3/SQLAlchemy): postgresql+psycopg://postgres:postgres@localhost:5001/postgres
DATABASE_URL=

# Alternatively, set this if provided by the database container:
POSTGRES_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_DB=postgres

# CORS/Frontend URL
FRONTEND_URL=http://localhost:3000

# Frontend service variables (for Vite):
# Vite exposes environment variables prefixed with VITE_
VITE_BACKEND_URL=http://localhost:3001
